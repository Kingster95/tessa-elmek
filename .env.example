# Which data source the UI uses. Read in exactly one place: src/data/index.ts
#   mock  -> local demo data with a simulated delay (default when missing)
#   api   -> real REST backend at VITE_API_BASE_URL
VITE_DATA_SOURCE=mock

# Base URL of the REST API, used only when VITE_DATA_SOURCE=api.
# No trailing slash. Endpoints are appended to it (e.g. /categories).
VITE_API_BASE_URL=http://localhost:3000/api

# Note: with VITE_DATA_SOURCE=api and no VITE_API_BASE_URL, the app falls back to
# the same-origin path "/api" and prints a warning in the browser console.
